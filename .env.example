TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Configure one or both providers. The bot can switch between them.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_TRANSCRIBE_MODEL=whisper-1

MAX_VIDEO_MINUTES=30
MAX_CLIPS=3
DEFAULT_CLIP_SECONDS=45
MAX_DOWNLOAD_MB=700
OUTPUT_WIDTH=1080
OUTPUT_HEIGHT=1920
TEMP_DIR=/tmp/clipforge

# Optional allow-list of Telegram numeric user IDs, comma-separated.
# Leave blank to allow anyone.
ALLOWED_TELEGRAM_IDS=
